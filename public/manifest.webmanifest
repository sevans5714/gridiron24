{
  "id": "/app/",
  "name": "GridIron 24",
  "short_name": "G24",
  "description": "GridIron 24 — standings, matchups, roster, and league HQ.",
  "start_url": "/app/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#02060f",
  "theme_color": "#02060f",
