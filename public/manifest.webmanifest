      "url": "/app/?source=pwa#home",
      "icons": [{ "src": "/assets/pwa/icon-192.png?v=128", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "My Matchup",
      "short_name": "Matchup",
      "description": "Your weekly matchup with live scores",
      "url": "/app/?source=pwa#matchup",
      "icons": [{ "src": "/assets/pwa/icon-192.png?v=128", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "My Roster",
      "short_name": "Roster",
      "description": "Your franchise roster",
      "url": "/app/?source=pwa#roster",
      "icons": [{ "src": "/assets/pwa/icon-192.png?v=128", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "League",
      "short_name": "League",
      "description": "Calendar, news, and messages",
