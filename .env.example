# Exact league name members must enter when creating an account (case-insensitive)
LEAGUE_NAME=4to12

# Shared league password required to create an account
LEAGUE_PASSWORD=change-me

# Login name that should be overall commissioner (promoted on signup / server start)
# COMMISSIONER_LOGIN=yourlogin

# Optional signing secret for session cookies (defaults to LEAGUE_PASSWORD)
# SESSION_SECRET=

# Optional public site URL used in password-reset emails
# APP_BASE_URL=https://gridiron24.onrender.com

# Optional Resend email delivery for password resets
# RESEND_API_KEY=
# MAIL_FROM=GridIron 24 <onboarding@resend.dev>

# Optional durable data directory (defaults to ./data)
# DATA_DIR=/var/data

# PORT=3001
