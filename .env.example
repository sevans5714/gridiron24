# Exact league name members must enter when creating an account (case-insensitive)
LEAGUE_NAME=4to12

# Shared league password required to create an account
LEAGUE_PASSWORD=change-me

# Login name that should be overall GridIron 24 commissioner (promoted on signup / server start)
# COMMISSIONER_LOGIN=sevans
# COMMISSIONER_PASSWORD=
# COMMISSIONER_EMAIL=sevans5714@gmail.com

# Separate AAA league admin account for the owner
# AAA_ADMIN_LOGIN=sevans-aaa
# AAA_ADMIN_PASSWORD=
# AAA_ADMIN_EMAIL=sevans5714+aaa@gmail.com

# Optional signing secret for session cookies (defaults to LEAGUE_PASSWORD)
# SESSION_SECRET=

# Optional public site URL used in password-reset emails
# APP_BASE_URL=https://www.gridiron24.com

# Optional Resend email delivery for password resets and invites
# RESEND_API_KEY=
# MAIL_FROM=GridIron 24 <onboarding@resend.dev>

# Weekly AI wrap-up (Commissioner → Generate & Send, or Tuesday cron)
# CRON_SECRET=long-random-string
# OPENAI_API_KEY=
# OPENAI_WRAP_MODEL=gpt-4.1-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_WRAP_MODEL=claude-sonnet-4-20250514
# WRAP_EMAIL_MODE=all

# Optional durable data directory (defaults to ./data)
# DATA_DIR=/var/data

# PORT=3001
